<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Engineering Admission Hub</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      background: #f4f7fb;
      color: #222;
    }

    header {
      background: #0b3d91;
      color: white;
      padding: 20px;
      text-align: center;
    }

    header h1 {
      font-size: 28px;
      margin-bottom: 8px;
    }

    header p {
      font-size: 15px;
    }

    nav {
      background: #062b68;
      padding: 12px;
      text-align: center;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin: 0 10px;
      font-size: 14px;
    }

    nav a:hover {
      text-decoration: underline;
    }

    .hero {
      padding: 45px 20px;
      text-align: center;
      background: white;
    }

    .hero h2 {
      color: #0b3d91;
      font-size: 30px;
      margin-bottom: 15px;
    }

    .hero p {
      max-width: 700px;
      margin: auto;
      line-height: 1.6;
      color: #555;
    }

    .container {
      max-width: 1100px;
      margin: auto;
      padding: 30px 20px;
    }

    .section-title {
      text-align: center;
      margin-bottom: 25px;
      color: #0b3d91;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
    }

    .card {
      background: white;
      padding: 25px;
      border-radius: 12px;
      box-shadow: 0 3px 12px rgba(0,0,0,0.08);
      text-align: center;
    }

    .card h3 {
      margin-bottom: 12px;
      color: #0b3d91;
    }

    .card p {
      color: #666;
      line-height: 1.5;
      margin-bottom: 15px;
    }

    .btn {
      display: inline-block;
      background: #0b3d91;
      color: white;
      padding: 10px 18px;
      border-radius: 7px;
      text-decoration: none;
      border: none;
      cursor: pointer;
    }

    .btn:hover {
      background: #062b68;
    }

    .notice {
      background: #fff3cd;
      padding: 20px;
      border-left: 5px solid #ffc107;
      margin-top: 30px;
      border-radius: 6px;
    }

    .contact {
      background: #0b3d91;
      color: white;
      padding: 35px 20px;
      text-align: center;
      margin-top: 20px;
    }

    footer {
      background: #062b68;
      color: white;
      text-align: center;
      padding: 18px;
      font-size: 14px;
    }

    @media (max-width: 600px) {
      header h1 {
        font-size: 23px;
      }

      .hero h2 {
        font-size: 24px;
      }

      nav a {
        display: inline-block;
        margin: 5px;
      }
    }
  </style>
</head>

<body>

  <header>
    <h1>Engineering Admission Hub</h1>
    <p>Your Study & Admission Preparation Platform</p>
  </header>

  <nav>
    <a href="#home">Home</a>
    <a href="#subjects">Subjects</a>
    <a href="#materials">Materials</a>
    <a href="#questions">Questions</a>
    <a href="#contact">Contact</a>
  </nav>

  <section class="hero" id="home">
    <h2>Prepare Smart. Study Better. Achieve Your Goal.</h2>
    <p>
      Welcome to Engineering Admission Hub.
      Find engineering admission resources, study materials,
      practice questions and useful preparation information in one place.
    </p>
  </section>

  <section class="container" id="subjects">
    <h2 class="section-title">Engineering Subjects</h2>

    <div class="cards">

      <div class="card">
        <h3>Physics</h3>
        <p>Important chapters, formulas and admission practice.</p>
        <a class="btn" href="#materials">Explore</a>
      </div>

      <div class="card">
        <h3>Chemistry</h3>
        <p>Concepts, equations and important admission questions.</p>
        <a class="btn" href="#materials">Explore</a>
      </div>

      <div class="card">
        <h3>Higher Math</h3>
        <p>Mathematical concepts and problem-solving practice.</p>
        <a class="btn" href="#materials">Explore</a>
      </div>

      <div class="card">
        <h3>Biology</h3>
        <p>Important biology topics and practice resources.</p>
        <a class="btn" href="#materials">Explore</a>
      </div>

    </div>
  </section>

  <section class="container" id="materials">
    <h2 class="section-title">Study Materials</h2>

    <div class="cards">

      <div class="card">
        <h3>📚 Notes</h3>
        <p>Chapter-wise study notes and important concepts.</p>
        <button class="btn" onclick="showMessage()">
          View Materials
        </button>
      </div>

      <div class="card">
        <h3>📝 Practice</h3>
        <p>Practice questions for engineering admission preparation.</p>
        <button class="btn" onclick="showMessage()">
          Practice Now
        </button>
      </div>

      <div class="card">
        <h3>📄 PDF Resources</h3>
        <p>Downloadable study resources will be added here.</p>
        <button class="btn" onclick="showMessage()">
          Download
        </button>
      </div>

    </div>

    <div class="notice">
      <strong>Notice:</strong>
      More study materials and admission resources will be added soon.
    </div>
  </section>

  <section class="container" id="questions">
    <h2 class="section-title">Admission Questions</h2>

    <div class="cards">

      <div class="card">
        <h3>Previous Questions</h3>
        <p>University admission question resources.</p>
        <button class="btn" onclick="showMessage()">
          Open
        </button>
      </div>

      <div class="card">
        <h3>Model Tests</h3>
        <p>Practice model tests for admission preparation.</p>
        <button class="btn" onclick="showMessage()">
          Start Test
        </button>
      </div>

    </div>
  </section>

  <section class="contact" id="contact">
    <h2>Engineering Admission Hub</h2>
    <p style="margin-top:10px;">
      Learn • Practice • Improve • Achieve
    </p>
  </section>

  <footer>
    © 2026 Engineering Admission Hub | All Rights Reserved
  </footer>

  <script>
    function showMessage() {
      alert("This section will be available soon!");
    }
  </script>

</body>
</html>