 <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Engineering Admission Hub</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f4f7fb;
            color: #222;
        }

        header {
            background: #0b5ed7;
            color: white;
            padding: 25px 15px;
            text-align: center;
        }

        header h1 {
            font-size: 28px;
            margin-bottom: 8px;
        }

        header p {
            font-size: 15px;
        }

        nav {
            background: #083b8a;
            padding: 12px;
            text-align: center;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 0 10px;
            font-size: 14px;
        }

        .hero {
            text-align: center;
            padding: 40px 20px;
            background: white;
        }

        .hero h2 {
            color: #0b5ed7;
            margin-bottom: 12px;
        }

        .hero p {
            margin-bottom: 20px;
        }

        .button {
            display: inline-block;
            background: #0b5ed7;
            color: white;
            padding: 12px 20px;
            border-radius: 8px;
            text-decoration: none;
        }

        .section {
            padding: 30px 15px;
            max-width: 1000px;
            margin: auto;
        }

        .section h2 {
            text-align: center;
            margin-bottom: 25px;
            color: #0b5ed7;
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 18px;
        }

        .card {
            background: white;
            padding: 22px;
            border-radius: 12px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.1);
            text-align: center;
        }

        .card h3 {
            margin-bottom: 10px;
            color: #083b8a;
        }

        .card p {
            margin-bottom: 15px;
            line-height: 1.5;
        }

        .card a {
            display: inline-block;
            background: #198754;
            color: white;
            padding: 9px 15px;
            border-radius: 6px;
            text-decoration: none;
        }

        footer {
            background: #083b8a;
            color: white;
            text-align: center;
            padding: 20px;
            margin-top: 30px;
        }
    </style>
</head>

<body>

    <header>
        <h1>Engineering Admission Hub</h1>
        <p>Your Study & Admission Preparation Platform</p>
    </header>

    <nav>
        <a href="#home">Home</a>
        <a href="#subjects">Subjects</a>
        <a href="#materials">Materials</a>
        <a href="#about">About</a>
    </nav>

    <section class="hero" id="home">
        <h2>Welcome to Engineering Admission Hub</h2>
        <p>
            Prepare for your engineering admission with organized
            study materials, subjects and practice resources.
        </p>

        <a class="button" href="#materials">Explore Materials</a>
    </section>

    <section class="section" id="subjects">
        <h2>Engineering Admission Subjects</h2>

        <div class="cards">

            <div class="card">
                <h3>Physics</h3>
                <p>Physics chapters, formulas and practice questions.</p>
                <a href="#">View Physics</a>
            </div>

            <div class="card">
                <h3>Chemistry</h3>
                <p>Chemistry concepts, equations and admission practice.</p>
                <a href="#">View Chemistry</a>
            </div>

            <div class="card">
                <h3>Higher Mathematics</h3>
                <p>Important mathematics topics and problem solving.</p>
                <a href="#">View Mathematics</a>
            </div>

            <div class="card">
                <h3>Biology</h3>
                <p>Biology topics and practice materials.</p>
                <a href="#">View Biology</a>
            </div>

        </div>
    </section>

    <section class="section" id="materials">
        <h2>Study Materials</h2>

        <div class="cards">

            <div class="card">
                <h3>Question Bank</h3>
                <p>Practice important admission questions.</p>
                <a href="#">Open</a>
            </div>

            <div class="card">
                <h3>Model Tests</h3>
                <p>Test your preparation with model questions.</p>
                <a href="#">Open</a>
            </div>

            <div class="card">
                <h3>PDF Materials</h3>
                <p>Download useful study materials and notes.</p>
                <a href="#">Open</a>
            </div>

        </div>
    </section>

    <section class="section" id="about">
        <h2>About This Website</h2>

        <div class="card">
            <p>
                Engineering Admission Hub is designed to help students
                organize their engineering admission preparation in one place.
            </p>
        </div>
    </section>

    <footer>
        <p>© 2026 Engineering Admission Hub</p>
        <p>Made for Admission Preparation</p>
    </footer>

</body>
